root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

[*.{csproj,sln,config,manifest,resx}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# The legacy runtime configuration files may use ANSI/GBK. Preserve their
# existing encoding and line endings instead of applying repository defaults.
[*.ini]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
