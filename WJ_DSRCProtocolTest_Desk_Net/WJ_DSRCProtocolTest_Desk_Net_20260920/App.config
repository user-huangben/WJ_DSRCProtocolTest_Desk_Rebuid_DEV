<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </appSettings>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Windows.Forms.DoNotSupportDpiChanges=false;Switch.System.Windows.Forms.EnableDpiChangedMessageHandling=true" />
  </runtime>
</configuration>
